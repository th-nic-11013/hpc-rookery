{
  "mcpServers": {
    "hpc": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "git+https://github.com/william-dawson/hpc-rookery.git@main",
        "hpc-mcp"
      ],
      "env": {}
    },
    "yagura": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "hpc-rookery[yagura] @ git+https://github.com/william-dawson/hpc-rookery.git@main",
        "yagura-mcp"
      ],
      "env": {}
    },
    "hyogo": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "hpc-rookery[gromacs] @ git+https://github.com/william-dawson/hpc-rookery.git@main",
        "hyogo-mcp"
      ],
      "env": {}
    }
  }
}
