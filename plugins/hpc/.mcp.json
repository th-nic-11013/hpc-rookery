{
  "mcpServers": {
    "hpc": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "git+https://github.com/th-nic-11013/hpc-rookery.git@hokusai-probed-facts",
        "hpc-mcp"
      ],
      "env": {}
    },
    "yagura": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "yagura[cif] @ git+https://github.com/th-nic-11013/yagura.git@main",
        "yagura-mcp"
      ],
      "env": {}
    },
    "hyogo": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "hyogo[gromacs] @ git+https://github.com/th-nic-11013/hyogo.git@main",
        "hyogo-mcp"
      ],
      "env": {}
    }
  }
}
