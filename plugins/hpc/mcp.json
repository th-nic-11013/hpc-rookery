{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "hpc": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "git+https://github.com/th-nic-11013/hpc-rookery.git@hokusai-probed-facts",
        "hpc-mcp"
      ],
      "env": {}
    },
    "yagura": {
      "type": "stdio",
      "command": "uv",
      "env": {},
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "hpc-rookery[yagura] @ git+https://github.com/th-nic-11013/hpc-rookery.git@hokusai-probed-facts",
        "yagura-mcp"
      ]
    },
    "hyogo": {
      "type": "stdio",
      "command": "uv",
      "env": {},
      "args": [
        "tool",
        "run",
        "--quiet",
        "--from",
        "hpc-rookery[gromacs] @ git+https://github.com/th-nic-11013/hpc-rookery.git@hokusai-probed-facts",
        "hyogo-mcp"
      ]
    }
  }
}
