 &GLOBAL
   BLACS_GRID SQUARE
   BLACS_REPEATABLE F
   PREFERRED_DIAG_LIBRARY SCALAPACK
   DIRECT_GENERALIZED_DIAGONALIZATION F
   PREFERRED_CHOLESKY_LIBRARY SCALAPACK
   PREFERRED_DGEMM_LIBRARY BLAS
   EPS_CHECK_DIAG -1.0000000000000000E+000
   ELPA_KERNEL AUTO
   ELPA_COMPLEX_KERNEL AUTO
   ELPA_NEIGVEC_MIN 64
   ELPA_QR F
   ELPA_ONE_STAGE F
   ELPA_PRINT F
   DLAF_NEIGVEC_MIN 1024
   DLAF_CHOLESKY_N_MIN 1024
   PREFERRED_FFT_LIBRARY FFTW3
   FFTW_WISDOM_FILE_NAME /etc/fftw/wisdom
   FFTW_PLAN_TYPE ESTIMATE
   FFT_POOL_SCRATCH_LIMIT 15
   ALLTOALL_SGL F
   PRINT_LEVEL LOW
   PROGRAM_NAME CP2K
   PROJECT_NAME "pbe-sp"
   OUTPUT_FILE_NAME
   RUN_TYPE ENERGY
   WALLTIME
   ECHO_INPUT F
   ECHO_ALL_HOSTS F
   ENABLE_MPI_IO T
   TRACE F
   TRACE_MASTER T
   TRACE_MAX 2147483647
   FLUSH_SHOULD_FLUSH T
   CALLGRAPH NONE
   CALLGRAPH_FILE_NAME
   SEED 2000
   SAVE_MEM F
 &END GLOBAL
 &FORCE_EVAL
   METHOD QS
   STRESS_TENSOR NONE
   &DFT
     BASIS_SET_FILE_NAME BASIS_SET
     POTENTIAL_FILE_NAME POTENTIAL
     UKS F
     ROKS F
     MULTIPLICITY 0
     CHARGE 0
     PLUS_U_METHOD MULLIKEN
     EPS_U_J_LOOP  1.0000000000000000E-002
     MAX_MTLR_LOOP 10
     RELAX_MULTIPLICITY  0.0000000000000000E+000
     SUBCELLS  2.0000000000000000E+000
     AUTO_BASIS "X" "X"
     SURFACE_DIPOLE_CORRECTION F
     SURF_DIP_DIR Z
     SURF_DIP_POS -1.0000000000000000E+000
     SURF_DIP_SWITCH F
     CORE_CORR_DIP F
     SORT_BASIS DEFAULT
     &SCF
       MAX_ITER_LUMO 299
       EPS_LUMO  1.0000000000000001E-005
       MAX_SCF 50
       MAX_SCF_HISTORY 0
       MAX_DIIS 4
       LEVEL_SHIFT  0.0000000000000000E+000
       EPS_SCF  9.9999999999999995E-007
       EPS_SCF_HISTORY  0.0000000000000000E+000
       CHOLESKY RESTORE
       EPS_EIGVAL  1.0000000000000001E-005
       EPS_DIIS  1.0000000000000001E-001
       SCF_GUESS ATOMIC
       EXTERNAL_DENSITY_FILE_NAME ""
       NROW_BLOCK 32
       NCOL_BLOCK 32
       ADDED_MOS "0"
       ROKS_SCHEME HIGH-SPIN
       ROKS_F  5.0000000000000000E-001
       ROKS_PARAMETERS -5.0000000000000000E-001  1.5000000000000000E+000  5.0000000000000000E-001  5.0000000000000000E-001 \
         1.5000000000000000E+000 -5.0000000000000000E-001
       IGNORE_CONVERGENCE_FAILURE F
       FORCE_SCF_CALCULATION F
       &PRINT
         DM_RESTART_WRITE F
         &RESTART ON
           ADD_LAST NUMERIC
           COMMON_ITERATION_LEVELS 3
           FILENAME RESTART
           LOG_PRINT_KEY F
           BACKUP_COPIES 1
         &END RESTART
       &END PRINT
     &END SCF
     &XC
       DENSITY_CUTOFF  1.0000000000000000E-010
       GRADIENT_CUTOFF  1.0000000000000000E-010
       DENSITY_SMOOTH_CUTOFF_RANGE  0.0000000000000000E+000
       TAU_CUTOFF  1.0000000000000000E-010
       LIBXC_GPU_BACKEND HOST
       2ND_DERIV_ANALYTICAL T
       3RD_DERIV_ANALYTICAL F
       STEP_SIZE  1.0000000000000000E-003
       NSTEPS 3
       &XC_FUNCTIONAL NO_SHORTCUT
         &PBE T
           PARAMETRIZATION ORIG
           SCALE_X  1.0000000000000000E+000
           SCALE_C  1.0000000000000000E+000
         &END PBE
       &END XC_FUNCTIONAL
     &END XC
   &END DFT
   &SUBSYS
     SEED 12345
     &CELL
       ABC  8.0000000000000000E+000  8.0000000000000000E+000  8.0000000000000000E+000
       ALPHA_BETA_GAMMA  9.0000000000000000E+001  9.0000000000000000E+001  9.0000000000000000E+001
       CELL_FILE_FORMAT CP2K
       CANONICALIZE AUTO
       PERIODIC XYZ
       MULTIPLE_UNIT_CELL 1 1 1
       SYMMETRY NONE
     &END CELL
     &COORD
 H 0.0 0.0 0.0
 H 0.0 0.0 0.74
       UNIT "angstrom"
       SCALED F
     &END COORD
     &KIND "H"
       BASIS_SET "DZVP-MOLOPT-SR-GTH"
       #AUX_BASIS_SET ""
       #RI_AUX_BASIS_SET ""
       #LRI_BASIS_SET ""
       #AUX_FIT_BASIS_SET ""
       CORE_CORRECTION  0.0000000000000000E+000
       MAGNETIZATION  0.0000000000000000E+000
       POTENTIAL_FILE_NAME "-"
       #POTENTIAL_TYPE ""
       POTENTIAL "GTH-PBE-q1"
       KG_POTENTIAL_FILE_NAME "-"
       KG_POTENTIAL "NONE"
       ECP_SEMI_LOCAL T
       COVALENT_RADIUS  0.0000000000000000E+000
       VDW_RADIUS  0.0000000000000000E+000
       MAX_RAD_LOCAL  2.4566439727513359E+001
       LEBEDEV_GRID 50
       RADIAL_GRID 50
       MM_RADIUS  0.0000000000000000E+000
       DFTB3_PARAM  0.0000000000000000E+000
       LMAX_DFTB -1
       MAO -1
       SE_P_ORBITALS_ON_H F
       GPW_TYPE F
       GHOST F
       MONOVALENT F
       FLOATING_BASIS_CENTER F
       NO_OPTIMIZE F
       PAO_BASIS_SIZE 0
     &END KIND
   &END SUBSYS
 &END FORCE_EVAL
