# geo_opt without a guess wavefunction, continued: RESTART 1 turns SCF_GUESS to RESTART, and CP2K reads its default wavefunction name
@SET PROJECT    pbe-geo
@SET RESTART    1
@SET SCF_GUESS  ATOMIC
@IF ${RESTART} == 1
@SET SCF_GUESS  RESTART
@ENDIF

&GLOBAL
  PROJECT     ${PROJECT}
  RUN_TYPE    GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL

@IF ${RESTART} == 1
&EXT_RESTART
  RESTART_FILE_NAME ${PROJECT}-1.restart
&END EXT_RESTART
@ENDIF

&FORCE_EVAL
  METHOD QS
  &DFT
    &SCF
      SCF_GUESS ${SCF_GUESS}
      EPS_SCF   1.0E-6
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    @INCLUDE subsys.inc
  &END SUBSYS
&END FORCE_EVAL
