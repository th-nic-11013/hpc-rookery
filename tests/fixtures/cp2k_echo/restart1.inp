# geo_opt continued after a walltime stop: RESTART 1 picks the run's own files
@SET PROJECT    hse06-geo
@SET RESTART    1
@SET WFN        ../pbe-guess/pbe-guess-RESTART.wfn
@IF ${RESTART} == 1
@SET WFN        ${PROJECT}-RESTART.wfn
@ENDIF

&GLOBAL
  PROJECT     ${PROJECT}
  RUN_TYPE    GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL

@IF ${RESTART} == 1
&EXT_RESTART
  RESTART_FILE_NAME ${PROJECT}-1.restart
&END EXT_RESTART
@ENDIF

&FORCE_EVAL
  METHOD QS
  &DFT
    WFN_RESTART_FILE_NAME ${WFN}
    &SCF
      SCF_GUESS RESTART
      EPS_SCF   1.0E-6
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    @INCLUDE subsys.inc
  &END SUBSYS
&END FORCE_EVAL
