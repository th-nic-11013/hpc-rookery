SYSTEM = Cr2CO2 f005 (step 60000) [magmom test2 damp]
# electronic
PREC   = Accurate
ENCUT  = 415
EDIFF  = 1E-6
IALGO  = 38
NELM   = 300
NELMIN = 2
LREAL  = AUTO
LASPH  = .TRUE.
ISMEAR = 0
SIGMA  = 0.04
GGA    = PE
# ionic: static single point, geometry frozen at the MD frame
IBRION = -1
NSW    = 0
# spin
ISPIN  = 2
MAGMOM = 1*0 2*1.5 7*0
# mixing (test2): Kerker kept on (BMIX 1), stronger damping
AMIX     = 0.2
BMIX     = 1.0
AMIN     = 0.01
AMIX_MAG = 0.4
BMIX_MAG = 1.0
# parallelisation: 48 ranks/lane, NCORE 12 -> 4 band groups
NCORE  = 12
NBANDS = 660
# output
LORBIT = 10
LWAVE  = .FALSE.
LCHARG = .FALSE.
NWRITE = 2
