# Validation run: nnvt steps NVT at 300 K (stability), then nnve steps NVE
# (energy conservation). Thermo every 10 steps for the drift fit.
include         ${inputs}/common.in
include         /lustre/home/thnic123/software/mlip/2026.10/bench/inputs/common.in
# Shared start of every MLMD benchmark run (included by md_time.in and md_valid.in).
# Command-line variables: data (LAMMPS data file), types (pair_coeff include),
# model (metatomic .pt), seed (velocity seed).
units           metal
atom_style      atomic
boundary        p p p
read_data       ${data}
read_data       /lustre/home/thnic123/software/mlip/2026.10/bench/structures/h2o-64.data
