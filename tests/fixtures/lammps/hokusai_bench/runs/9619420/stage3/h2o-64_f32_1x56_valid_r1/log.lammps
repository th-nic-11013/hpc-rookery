include         ${types}
include         /lustre/home/thnic123/software/mlip/2026.10/bench/structures/h2o-64.types.in
# LAMMPS types 1..2 = H O
pair_coeff * * 1 8

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes
timestep        0.0005                  # 0.5 fs, as the CP2K AIMD benchmark

thermo_style    custom step temp pe ke etotal press
thermo_modify   norm no flush yes format float %.10f

# step 0 energy at the input geometry (checked against the ASE reference)
run             0

