#
#  define units
#
units       lj

#
#  specify periodic boundary conditions
#
boundary p p p

#
#  define atom_style
#  full covers everything
#
atom_style  full

#
# Read the restart file and restart the counter on timesteps
#
read_restart lj.equilibration.restart.100000
Reading restart file ...
